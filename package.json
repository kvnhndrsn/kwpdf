{
  "name": "kwpdf",
  "version": "0.94.0",
  "private": true,
  "description": "PDF/DOCX keyword scanner",
  "type": "module",
  "scripts": {
    "build": "node build.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vitest bench --run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.strict.json",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,js}\" \"*.js\"",
    "format:check": "prettier --check \"src/**/*.{ts,js}\" \"*.js\""
  },
  "dependencies": {
    "@tesseract.js-data/eng": "1.0.0",
    "jszip": "3.10.1",
    "mammoth": "1.11.0",
    "pdfjs-dist": "^4.10.38",
    "tesseract.js": "5.1.1",
    "tesseract.js-core": "5.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^25.9.1",
    "esbuild": "^0.25.2",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.7"
  }
}
